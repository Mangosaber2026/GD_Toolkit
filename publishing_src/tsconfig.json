{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",

        "rootDir": ".",
        "outDir": "./publishing_dist",

        "strict": true,
        "skipLibCheck": true,

        "types": ["node"]
    },

    "include": [
        "./**/*.ts"
    ],

    "exclude": [
        "./publishing_dist",
        "./node_modules"
    ]
}