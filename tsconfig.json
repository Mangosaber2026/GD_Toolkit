
{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",

    "rootDir": "./src",
    "outDir": "./dist",

    "lib": ["ESNext"],
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "verbatimModuleSyntax": true,

    "sourceMap": true,
    "noEmitOnError": true,
    "skipLibCheck": true
  }
}
